generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Aluno {
  id             Int      @id @default(autoincrement())
  nome           String
  email          String   @unique
  senha          String   @default("12345678")
  cpf            String   @unique
  rg             String?
  endereco       String?
  instituicao    String?
  curso          String?
  saldo          Int      @default(0)
  dataNascimento DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  transacoes     Transacao[] @relation("TransacoesRecebidas")
  resgates       Resgate[]
}

model Professor {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String   @default("12345678")
  cpf          String   @unique
  departamento String?
  saldo        Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transacoes   Transacao[] @relation("TransacoesEnviadas")
}

model Transacao {
  id           Int      @id @default(autoincrement())
  professorId  Int
  alunoId      Int
  valor        Int
  motivo       String
  data         DateTime @default(now())

  professor    Professor @relation("TransacoesEnviadas", fields: [professorId], references: [id])
  aluno        Aluno     @relation("TransacoesRecebidas", fields: [alunoId], references: [id])
}

model EmpresaParceira {
  id           Int      @id @default(autoincrement())
  nomeFantasia String
  cnpj         String   @unique
  email        String   @unique
  senha        String   @default("12345678")
  telefone     String?
  endereco     String?
  setor        String?
  responsavel  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vantagens    Vantagem[]
}

model Vantagem {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  titulo      String
  descricao   String
  custo       Int
  imagem      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa     EmpresaParceira @relation(fields: [empresaId], references: [id])
  resgates    Resgate[]
}

model Resgate {
  id          Int      @id @default(autoincrement())
  alunoId     Int
  vantagemId  Int
  codigo      String   @unique
  data        DateTime @default(now())

  aluno       Aluno    @relation(fields: [alunoId], references: [id])
  vantagem    Vantagem @relation(fields: [vantagemId], references: [id])
}
